<?xml version="1.0"?>
<sdf version="1.9">
  <world name="devices_demo">
    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size><real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene><ambient>0.1 0.1 0.1 1</ambient><background>0.04 0.04 0.06 1</background></scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose><diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular><direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>false</cast_shadows>
    </light>
    <!-- Observer image verifies server-side emissive updates, not just GUI changes. -->
    <model name="observer">
      <static>true</static>
      <link name="camera_link">
        <pose>3 3 3.5 0 0.32 -2.35619449</pose>
        <sensor name="camera" type="camera">
          <always_on>true</always_on><update_rate>10</update_rate>
          <topic>/vessel_devices/observer/image</topic>
          <camera>
            <horizontal_fov>1.05</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>30</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
