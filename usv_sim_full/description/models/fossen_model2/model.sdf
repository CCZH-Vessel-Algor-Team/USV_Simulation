<?xml version="1.0"?>
<sdf version="1.9">
  <!-- One carrier link: M below is NOT a physical mass identification.
       Effective surge/sway/yaw inertia is supplied by FossenPlanar. -->
  <model name="usv_1">
    <pose>0 0 0 0 0 0</pose>
    <link name="base_link">
      <gravity>false</gravity>
      <inertial>
        <mass>50.05</mass>
        <inertia><ixx>10</ixx><iyy>10</iyy><izz>17.21</izz></inertia>
      </inertial>
      <collision name="hull">
        <pose>0 0 0.08 0 0 0</pose>
        <geometry><box><size>1.5 0.75 0.25</size></box></geometry>
      </collision>
      <visual name="hull">
        <pose>-0.028454 0.008375 0 0 0 0</pose>
        <geometry><mesh>
          <uri>package://usv_sim_full/description/models/body-Base/mesh/M5_body.dae</uri>
          <scale>0.28500925 0.28500925 0.28500925</scale>
        </mesh></geometry>
      </visual>
      <!-- Propulsion is two longitudinal point forces at y=+/-0.26 m;
           no propeller joint, RPM model, thrust lag or steering actuator. -->
      <sensor name="front_lidar" type="gpu_lidar">
        <pose>0 0 0.65 0 0 0</pose>
        <topic>/usv_1/sensors/lidar/front_lidar/scan</topic>
        <gz_frame_id>usv_1/front_lidar_link</gz_frame_id>
        <update_rate>10</update_rate><always_on>true</always_on>
        <lidar>
          <scan><horizontal><samples>720</samples><resolution>1</resolution>
            <min_angle>-3.141592653589793</min_angle><max_angle>3.141592653589793</max_angle>
          </horizontal></scan>
          <range><min>0.15</min><max>60</max><resolution>0.02</resolution></range>
        </lidar>
      </sensor>
      <sensor name="front_camera" type="camera">
        <pose>0.35 0 0.55 0 0 0</pose>
        <topic>/usv_1/sensors/camera/front_cam/image_raw</topic>
        <gz_frame_id>usv_1/front_cam_optical</gz_frame_id>
        <update_rate>10</update_rate><always_on>true</always_on>
        <camera><horizontal_fov>1.3962634</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>150</far></clip>
        </camera>
      </sensor>
    </link>
    <plugin filename="libFossenPlanar.so" name="vrx::FossenPlanar">
      <link_name>base_link</link_name><namespace>usv_1</namespace>
      <m11>50.05</m11><m22>84.36</m22><m33>17.21</m33>
      <X_u>151.57</X_u><Y_v>132.5</Y_v><N_r>34.56</N_r>
      <thruster_spacing>0.52</thruster_spacing><max_thrust>125</max_thrust>
      <command_timeout>0.5</command_timeout>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>usv_1/odom</odom_frame><robot_base_frame>usv_1/base_link</robot_base_frame>
      <odom_topic>/usv_1/odom</odom_topic><odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </model>
</sdf>
