
<!--
  COLREGS Local Planner Server 版 NavigateThroughPoses 行为树（占位）。
  colregs_local_planner_server 只提供 compute_path_to_pose action
  （无 compute_path_through_poses），因此"途经多点"导航暂不支持：
  收到 NavigateThroughPoses 目标后立即失败返回。

  该文件存在的目的：bt_navigator 在 on_configure 时会同时预加载
  navigate_to_pose 与 navigate_through_poses 两个默认 BT；若不覆盖后者，
  将因默认 BT 中的 ComputePathThroughPoses action server 不存在而
  configure 失败，导致整个导航栈 lifecycle 中止。
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="0" name="NavigateThroughPoses">
      <AlwaysFailure name="ThroughPosesUnsupportedByColregsServer"/>
      <AlwaysFailure name="NoRecovery"/>
    </RecoveryNode>
  </BehaviorTree>
</root>
