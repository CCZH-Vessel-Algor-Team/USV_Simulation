<?xml version="1.0"?>
<sdf version="1.9">
  <model name="iea15_offshore_turbine">
    <static>false</static>
    <link name="support">
      <kinematic>true</kinematic>
      <gravity>false</gravity>
      <pose>0 0 0 0 0 0</pose>
      <visual name="tower_nacelle">
        <geometry><mesh><uri>meshes/tower_nacelle.obj</uri><scale>1 1 1</scale></mesh></geometry>
        <material>
          <ambient>0.72 0.74 0.76 1</ambient>
          <diffuse>0.72 0.74 0.76 1</diffuse>
        </material>
      </visual>
      <collision name="monopile">
        <pose>0 0 68.5 0 0 0</pose>
        <geometry><cylinder><radius>5.0</radius><length>153</length></cylinder></geometry>
      </collision>
    </link>
    <link name="rotor">
      <gravity>false</gravity>
      <pose>11.288 0 150 0 -0.104720 0</pose>
      <inertial>
        <mass>300000</mass>
        <inertia>
          <ixx>1.5e8</ixx>
          <iyy>8.0e7</iyy>
          <izz>8.0e7</izz>
        </inertia>
      </inertial>
      <visual name="rotor">
        <geometry><mesh><uri>meshes/rotor.obj</uri><scale>1 1 1</scale></mesh></geometry>
        <material>
          <ambient>0.90 0.91 0.92 1</ambient>
          <diffuse>0.90 0.91 0.92 1</diffuse>
        </material>
      </visual>
    </link>
    <!-- DART does not keep a kinematic parent fixed once a heavy rotor is jointed to it. -->
    <joint name="world_anchor" type="fixed">
      <parent>world</parent>
      <child>support</child>
    </joint>
    <!-- Joint pose is expressed in the child (rotor) frame; identity keeps the shaft at the hub. -->
    <joint name="rotor_shaft" type="revolute">
      <parent>support</parent>
      <child>rotor</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>1e12</effort>
          <velocity>2.0</velocity>
        </limit>
        <dynamics>
          <damping>0</damping>
          <friction>0</friction>
        </dynamics>
      </axis>
    </joint>
    <plugin filename="gz-sim-joint-controller-system" name="gz::sim::systems::JointController">
      <joint_name>rotor_shaft</joint_name>
      <initial_velocity>0.7906</initial_velocity>
      <use_force_commands>false</use_force_commands>
    </plugin>
  </model>
</sdf>
